{
  "version": 2,
  "buildCommand": "cd continuum && npm install && npm run build",
  "outputDirectory": "continuum/dist",
  "framework": null,
  "devCommand": "cd continuum && npm run dev",
  "installCommand": "npm install && cd continuum && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
